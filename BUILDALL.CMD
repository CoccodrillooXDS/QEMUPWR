@ECHO OFF
IF "%BASEDIR%"=="" GOTO NOENV
IF NOT EXIST qemupwr.c GOTO NOSOURCE
IF NOT EXIST qemupwr_core.c GOTO NOSOURCE
IF NOT EXIST qemupwr_gui.c GOTO NOSOURCE
IF NOT EXIST qemupwrsvc.c GOTO NOSOURCE
IF NOT EXIST qpwremap.c GOTO NOSOURCE
IF NOT EXIST obj\NUL MD obj
IF NOT EXIST obj\i386\NUL MD obj\i386
IF NOT EXIST obj\i386\checked\NUL MD obj\i386\checked
IF NOT EXIST obj\i386\checked\NUL GOTO FAILED
IF EXIST obj\i386\checked\qemupwr.sys DEL obj\i386\checked\qemupwr.sys
IF EXIST QEMUPWR.SYS DEL QEMUPWR.SYS
IF EXIST QEMUPWR.EXE DEL QEMUPWR.EXE
IF EXIST QEMUPWRCTL.EXE DEL QEMUPWRCTL.EXE
IF EXIST QPWREMAP.EXE DEL QPWREMAP.EXE
IF EXIST QEMUPWRSVC.EXE DEL QEMUPWRSVC.EXE

ECHO [1/3] Building QEMUPWR.SYS...
"%BASEDIR%\BIN\BUILD.EXE" -c
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST obj\i386\checked\qemupwr.sys GOTO FAILED

ECHO [2/3] Building QEMUPWR.EXE...
CL /nologo /W3 /c qemupwr_core.c qemupwr_gui.c qpwremap.c qemupwrsvc.c
IF ERRORLEVEL 1 GOTO FAILED
LINK /nologo /SUBSYSTEM:WINDOWS,3.51 /ENTRY:WinMainCRTStartup /OUT:QEMUPWR.EXE qemupwr_gui.obj qemupwr_core.obj qpwremap.obj qemupwrsvc.obj KERNEL32.LIB ADVAPI32.LIB USER32.LIB COMDLG32.LIB
IF ERRORLEVEL 1 GOTO FAILED

ECHO [3/3] Copying driver...
COPY obj\i386\checked\qemupwr.sys QEMUPWR.SYS > NUL
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST QEMUPWR.EXE GOTO FAILED
IF NOT EXIST DIST\NUL MD DIST
IF NOT EXIST DIST\NUL GOTO FAILED
COPY QEMUPWR.EXE DIST\QEMUPWR.EXE > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY QEMUPWR.SYS DIST\QEMUPWR.SYS > NUL
IF ERRORLEVEL 1 GOTO FAILED

ECHO Build complete. DIST contains QEMUPWR.EXE and QEMUPWR.SYS.
GOTO END
:NOENV
ECHO ERROR: NT 3.51 DDK build environment not configured.
GOTO END
:NOSOURCE
ECHO ERROR: QEMUPWR sources missing.
GOTO END
:FAILED
ECHO ERROR: Build failed.
:END
